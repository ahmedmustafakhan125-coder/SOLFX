# Rust build output. Redirected to native Linux disk by .cargo/config.toml, but ignore
# the default location too in case the redirect is ever removed.
/target
**/*.rs.bk

# Coverage
*.profraw
*.profdata
/lcov.info

# Node / frontend (Phase 8)
node_modules/
.next/
dist/

# Anchor (Phase 2)
.anchor/
test-ledger/

# Keys — never commit one, on any cluster.
*.pem
id.json
keypair*.json
!Anchor.toml

# Probe data: large, regenerable, and not source.
scratch/feed-probe/data/
scratch/feed-probe/*.log

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local agent / IDE config — keep on disk, never on GitHub.
.cursor/
.claude/
.mcp.json
CLAUDE.md
CLAUDE-SESSION.md

# Design dumps and generated diagram rasters. Source .dot files stay tracked.
design/stitch/
app/og-image.png

# API keys and local secrets. The Pyth Hermes key lives here from 26 Aug 2026, when the
# public endpoint went behind authentication. A key committed to git is a key you must
# rotate, so it never gets to be committed once.
.env
.env.*
!.env.example

# Program upgrade authority keypairs. Losing these means the program can never be
# upgraded again; committing them means anyone can upgrade it. Back up OUT of band.
keys/

# Per-feed price-update account keypairs written by the price poster.
price-accounts/
# ...and any renamed or set-aside copy of them. On 2026-09-07 the admin-owned set was moved
# to `price-accounts.admin-owned/` so a fresh operator-owned set could be generated beside
# it. The rename stepped straight out from under the rule above, leaving 35 raw private keys
# untracked but committable in a repo with a public remote. The glob is the fix: a directory
# whose name starts `price-accounts.` holds private keys whatever the suffix says.
price-accounts.*/

# Generated map of feed id -> price account; regenerate with the poster.
price-accounts.json
# The map itself is only public addresses, but the same reasoning applies to its copies:
# ignore them all and publish the one the web tier serves, from `web-public/`.
price-accounts.*.json

# Written by init-protocol; regenerate rather than commit — it names cluster-specific
# accounts and is meaningless against a different ledger.
deployment.json
# Any scoped variant of it — e.g. deployment.crypto.json, the weekend feed set. Generated
# from what is on chain, so it is regenerated rather than committed, exactly like its parent.
deployment.*.json
.stack-logs/
