# Rust build output. Redirected to native Linux disk by .cargo/config.toml, but ignore
# the default location too in case the redirect is ever removed.
/target
**/*.rs.bk

# Coverage
*.profraw
*.profdata
/lcov.info

# Node / frontend (Phase 8)
node_modules/
.next/
dist/

# Anchor (Phase 2)
.anchor/
test-ledger/

# Keys — never commit one, on any cluster.
*.pem
id.json
keypair*.json
!Anchor.toml

# Probe data: large, regenerable, and not source.
scratch/feed-probe/data/
scratch/feed-probe/*.log

# Editor / OS
.vscode/
.idea/

# Claude Code: the shared config (.claude/settings.json, .claude/rules/, CLAUDE.md) is
# committed on purpose. Only personal overrides and session scratch are ignored.
.claude/settings.local.json
.claude/worktrees/
.DS_Store
Thumbs.db

# API keys and local secrets. The Pyth Hermes key lives here from 26 Aug 2026, when the
# public endpoint went behind authentication. A key committed to git is a key you must
# rotate, so it never gets to be committed once.
.env
.env.*
!.env.example

# Program upgrade authority keypairs. Losing these means the program can never be
# upgraded again; committing them means anyone can upgrade it. Back up OUT of band.
keys/

# Per-feed price-update account keypairs written by the price poster.
price-accounts/

# Generated map of feed id -> price account; regenerate with the poster.
price-accounts.json

# Written by init-protocol; regenerate rather than commit — it names cluster-specific
# accounts and is meaningless against a different ledger.
deployment.json
