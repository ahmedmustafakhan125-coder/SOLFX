#!/usr/bin/env sh
# Refuse a push that carries a secret — the last gate, and the one that also covers commits made
# with --no-verify or on another machine. The repository is public. See scripts/check-secrets.py.
root="$(git rev-parse --show-toplevel)"
zero=0000000000000000000000000000000000000000
status=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue            # deleting a branch pushes no content
  if [ "$remote_sha" = "$zero" ]; then
    range="$local_sha --not --remotes"               # a new branch: everything not yet public
  else
    range="$remote_sha..$local_sha"
  fi
  # shellcheck disable=SC2086
  python3 "$root/scripts/check-secrets.py" --range $range || status=1
done
exit $status
