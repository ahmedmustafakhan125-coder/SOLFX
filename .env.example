# Copy to `.env` and fill in. `.env` is gitignored; this file is not.
#
#     cp .env.example .env
#     $EDITOR .env
#     set -a && . ./.env && set +a      # load into the current shell

# --- Pyth Hermes -------------------------------------------------------------------------
#
# REQUIRED. Pyth put the public Hermes endpoint behind authentication on
# 26 August 2026 at 16:00 UTC. Without a key every request returns 401, which means:
#
#   * `deploy-localnet.sh` cannot derive the Pyth accounts to clone
#   * `price-poster` cannot fetch signed updates, so no price can be posted
#   * `devnet-feed-probe` cannot read the feed catalogue
#   * the keeper's price crank cannot detect a stalled feed
#
# In short: no key, no prices, no trading — on any cluster.
#
# Get one free at https://pythdata.app (Pyth Terminal), then "View your API key".
# Public Hermes is rate-limited to 30 requests per 10 seconds per IP; for production use a
# node provider (Triton, P2P, extrnode, Liquify).
PYTH_API_KEY=

# --- optional overrides ------------------------------------------------------------------

# Defaults to https://pyth.dourolabs.app/hermes (Pyth's upgraded backend). The older
# https://hermes.pyth.network still works with the same key.
# SOLFX_HERMES_URL=

# Cluster the keeper and tools talk to. Defaults to localnet.
# SOLFX_RPC_URL=https://api.devnet.solana.com

# Keeper identity and its USDC account for liquidation penalties. `run-keeper.sh` creates the
# token account for you if SOLFX_USDC_MINT is set (read it out of deployment.json).
# SOLFX_KEYPAIR=
# SOLFX_USDC_MINT=
# SOLFX_REWARD_TOKEN_ACCOUNT=
